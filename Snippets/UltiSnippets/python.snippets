snippet gen "Test case generator"
from numpy.random import permutation
from random import randint, choices
from os import system
import sys

abc = "abcdefghijklmnopqrstuvwxyz"
ABC = abc.upper()
dx = [0, 0, 1, -1]
dy = [1, -1, 0, 0]
dxKn = [-2, -1, 1, 2,  2,  1, -1, -2]
dyKn = [ 1,  2, 2, 1, -1, -2, -2, -1]
dxK = [0, 0, 1, -1, 1, 1, -1, -1]
dyK = [1, -1, 0, 0, 1, -1, 1, -1]
 
MOD = (1e9) + 7
INF = (1e9) + 100
INF64 = 2e18
PI = (3.1415926535897932384626433832795)
e = (2.7182818284590452353602874713527)
EPS = 1e-9

def gen():
	sys.stdout = open("in","w")
	
	# Print output
	
	sys.stdout = sys.__stdout__


it=100
for _ in range(it):
	gen()
	system("./me<in>o")
	system("./he<in>o2")
	
	x=open("o", "r").read().strip()
	y=open("o2", "r").read().strip()
	
	if x != y:
		print("FAILED!!!")
		exit(0)
	
	print("OK", _+1)
endsnippet
